# Writes OUT, a header defining RT_CALL_CAPTURE_COMMIT: the commit SOURCE_DIR is checked out at,
# with "-dirty" when runtime/ differs from it, or "unknown" outside a git checkout. Run at every
# build (runtime/CMakeLists.txt), so records name the code they were made with; OUT is rewritten
# only when the value changes, so an unchanged commit rebuilds nothing.
execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
                OUTPUT_VARIABLE commit RESULT_VARIABLE failed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(failed OR NOT commit MATCHES "^[0-9a-f]+$")
    set(commit unknown)
else()
    execute_process(COMMAND git -C "${SOURCE_DIR}" diff --quiet HEAD -- runtime
                    RESULT_VARIABLE dirty OUTPUT_QUIET ERROR_QUIET)
    if(dirty)
        string(APPEND commit -dirty)
    endif()
endif()
file(WRITE "${OUT}.new" "/* Generated by runtime/call_capture_commit.cmake. */\n#define RT_CALL_CAPTURE_COMMIT \"${commit}\"\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.new" "${OUT}")
file(REMOVE "${OUT}.new")
